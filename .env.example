# MongoDB Atlas > Database > Connect > Drivers (Node.js)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=your_database_name

# Public URL for this app, with no trailing slash
APP_URL=https://your-app.example

# Shopify Admin API credentials (server-side only; never use NEXT_PUBLIC_).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_shopify_client_id
SHOPIFY_CLIENT_SECRET=replace_with_shopify_client_secret

# Used once by scripts/create-first-admin.mjs; never used for customer accounts.
FIRST_ADMIN_USERNAME=replace_with_admin_username
FIRST_ADMIN_PASSWORD=replace_with_a_unique_strong_password

